{
  "name": "berlin-club-dj",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A personal archive of who played at Berghain Klubnacht and Sisyphos.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest": "npm run ingest:berghain && npm run ingest:berghain:times && npm run ingest:sisyphos && npm run ingest:tresor",
    "ingest:berghain": "node scripts/ingest-berghain.mjs",
    "ingest:berghain:times": "node scripts/ingest-berghain-times.mjs",
    "ingest:sisyphos": "node scripts/ingest-sisyphos.mjs",
    "ingest:tresor": "node scripts/ingest-tresor.mjs",
    "capture": "node scripts/orchestrate.mjs",
    "capture:full": "node scripts/orchestrate.mjs --full",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "stats": "node scripts/stats.mjs"
  }
}
